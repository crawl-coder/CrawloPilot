# CrawloPilot 环境变量配置示例
# 复制此文件为 .env 并修改相应配置
# 警告：请勿将 .env 文件提交到 Git！

# ====== 数据库配置 ======
# 本地开发（Homebrew / Docker 本机 MySQL）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=crawlopilot
MYSQL_PASSWORD=crawlopilot123
MYSQL_DATABASE=crawlo_pilot

# ====== Redis 配置 ======
# 本地开发（需启动本机 Redis，默认无密码）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# Redis 密码（可选）
# REDIS_PASSWORD=

# ====== JWT 配置 ======
# 生产环境务必使用复杂随机密钥！
# 生成命令: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# ====== MinIO 对象存储 ======
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=crawlopilot

# ====== Docker 配置 ======
DOCKER_HOST=unix:///var/run/docker.sock

# ====== 存储配置 ======
# 代码/上传/任务日志根目录（默认相对 backend 工作目录；生产请用绝对路径如 /data/crawlopilot/uploads）
# UPLOAD_DIR=uploads
# 任务日志保留天数（0 = 不清理，默认 30）
# TASK_LOG_RETENTION_DAYS=30

# ====== Celery 异步任务 ======
# 默认使用 Redis URL，可以单独配置
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ====== 监控告警 ======
# SMTP 邮件配置（告警通知）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=
# ALERT_EMAIL=admin@example.com

# 钉钉机器人 Webhook
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx

# 企业微信机器人 Webhook
# WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ====== 应用配置 ======
DEBUG=true
API_PREFIX=/api/v1

# 开放注册：false 时 /auth/register 仅 admin 可用（内部平台建议 false）
ALLOW_OPEN_REGISTER=false
