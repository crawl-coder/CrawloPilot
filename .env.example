# CrawloPilot 环境变量配置示例
# 复制此文件为 .env 并修改相应配置
# 警告：请勿将 .env 文件提交到 Git！

# ====== 数据库配置 ======
# 使用 Docker 时，host 为服务名称（如 mysql、117.72.16.51）
# 使用本地开发时，host 为 localhost
MYSQL_HOST=117.72.16.51
MYSQL_PORT=3306
MYSQL_USER=crawlo
MYSQL_PASSWORD=bJjGTZN4cDf6bmjc
MYSQL_DATABASE=crawlo_pilot

# ====== Redis 配置 ======
REDIS_HOST=117.72.16.51
REDIS_PORT=6379
REDIS_DB=0
# Redis 密码（可选）
# REDIS_PASSWORD=

# ====== JWT 配置 ======
# 生产环境务必使用复杂随机密钥！
# 生成命令: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# ====== MinIO 对象存储 ======
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=crawlopilot

# ====== Docker 配置 ======
DOCKER_HOST=unix:///var/run/docker.sock

# ====== Celery 异步任务 ======
# 默认使用 Redis URL，可以单独配置
# CELERY_BROKER_URL=redis://117.72.16.51:6379/1
# CELERY_RESULT_BACKEND=redis://117.72.16.51:6379/2

# ====== 监控告警 ======
# SMTP 邮件配置（告警通知）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=
# ALERT_EMAIL=admin@example.com

# 钉钉机器人 Webhook
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx

# 企业微信机器人 Webhook
# WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ====== 应用配置 ======
DEBUG=false
API_PREFIX=/api/v1

